DJANGO_PRODUCTION=false
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Neon에서 복사한 pooled connection string을 사용하려면 아래에 입력합니다.
# 예: postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
DATABASE_URL=

# DATABASE_URL을 사용하지 않는 로컬 PostgreSQL 설정입니다.
POSTGRES_DB=assignment_signal
POSTGRES_USER=assignment_user
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 운영에서 실제 이메일 인증을 사용할 때만 입력합니다.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="과제신호등 <noreply@example.com>"

# 브라우저 푸시 알림을 사용할 때 생성한 VAPID 키를 입력합니다.
# 실제 개인키는 GitHub에 올리지 않습니다.
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:contact@example.com
